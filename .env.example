# Copie este archivo como .env y cambie los valores.
# Clave larga y aleatoria para firmar las sesiones. Genere una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SISPREGUAICA_SECRETO=cambie-esto

# Base de datos. Por defecto, un archivo SQLite en la carpeta del programa.
DATABASE_URL=sqlite:///./sispreguaica.db
# Con PostgreSQL (requiere: pip install ".[postgres]"):
# DATABASE_URL=postgresql+psycopg://sispreguaica:clave@localhost:5432/sispreguaica

# Nombre del ente mientras no se configure en el programa (Administración > Configuración).
SISPREGUAICA_ENTE=Ente público

# Ponga 1 si el sistema se sirve con HTTPS.
SISPREGUAICA_COOKIE_SEGURA=0

# --- Solo para Docker (docker-compose.yml) ---
# Clave inicial del usuario admin (se usa una sola vez, al crear la base).
SISPREGUAICA_ADMIN_CLAVE=
# Clave del usuario de PostgreSQL dentro de Docker.
POSTGRES_PASSWORD=cambie-esta-clave
